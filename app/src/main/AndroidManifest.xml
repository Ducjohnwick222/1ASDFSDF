<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:label="Chi tiêu của tôi" />
        <activity android:name=".AddEditExpenseActivity" android:label="Thêm khoản chi"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".ExpenseDetailActivity" android:label="Chi tiết khoản chi"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".StatisticsActivity" android:label="Thống kê chi tiêu"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
