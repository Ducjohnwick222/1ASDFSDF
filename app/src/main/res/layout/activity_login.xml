<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="300dp"
        android:background="@drawable/bg_header_login"
        android:gravity="center" android:orientation="vertical">
        <TextView
            android:layout_width="88dp" android:layout_height="88dp"
            android:background="@drawable/bg_circle_white" android:gravity="center"
            android:text="đ" android:textColor="@color/primary"
            android:textSize="46sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Quản lý chi tiêu"
            android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Theo dõi từng đồng, tiêu xài thông minh"
            android:textColor="#CCFFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="-56dp"
        app:cardCornerRadius="24dp" app:cardElevation="8dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Đăng nhập" android:textColor="@color/ink"
                android:textSize="22sp" android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="Tên đăng nhập"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                android:hint="Nhập tên đăng nhập" android:inputType="text"
                android:maxLines="1" android:paddingHorizontal="16dp" android:textSize="15sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Mật khẩu"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                android:hint="Nhập mật khẩu" android:inputType="textPassword"
                android:maxLines="1" android:paddingHorizontal="16dp" android:textSize="15sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_error"
                android:padding="10dp" android:textColor="@color/red" android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="20dp" android:background="@drawable/bg_btn_primary"
                android:text="Đăng nhập" android:textAllCaps="false"
                android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginVertical="20dp" android:gravity="center"
        android:text="Tài khoản mẫu: admin / 123456"
        android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>
</ScrollView>
